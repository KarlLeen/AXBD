[Unit]
Description=AthenaX BD Agent — weekly pipeline scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=athenax
WorkingDirectory=/opt/athenax
EnvironmentFile=/opt/athenax/.env
Environment=HOME=/opt/athenax
Environment=UV_CACHE_DIR=/opt/athenax/.cache/uv
ExecStart=/opt/athenax/.venv/bin/athenax schedule --day monday --time 09:00
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal
# Pipeline peaks at ~800 MB; 2.5G cap leaves headroom for dashboard on 4 GB VPS
MemoryMax=2500M
OOMPolicy=continue
Nice=10

[Install]
WantedBy=multi-user.target
