[Unit]
Description=AthenaX BD Agent — weekly pipeline scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=athenax
WorkingDirectory=/opt/athenax
EnvironmentFile=/opt/athenax/.env
ExecStart=/opt/athenax/.venv/bin/athenax schedule --day monday --time 09:00
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal
# 1 GB RAM optimisation — pipeline peaks at ~800 MB; swap handles the rest
MemoryMax=900M
OOMPolicy=continue
Nice=10

[Install]
WantedBy=multi-user.target
