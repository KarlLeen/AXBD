[Unit]
Description=AthenaX BD Agent — Telegram admin bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=athenax
WorkingDirectory=/opt/athenax
EnvironmentFile=/opt/athenax/.env
ExecStart=/opt/athenax/.venv/bin/athenax bot
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
