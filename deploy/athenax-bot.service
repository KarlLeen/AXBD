[Unit]
Description=AthenaX BD Agent — Telegram admin bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=athenax
WorkingDirectory=/opt/athenax
EnvironmentFile=/opt/athenax/.env
Environment=HOME=/opt/athenax
Environment=UV_CACHE_DIR=/opt/athenax/.cache/uv
ExecStart=/opt/athenax/.venv/bin/athenax bot
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
MemoryMax=150M
Nice=15

[Install]
WantedBy=multi-user.target
