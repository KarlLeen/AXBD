[Unit]
Description=AthenaX BD Agent — web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=athenax
WorkingDirectory=/opt/athenax
EnvironmentFile=/opt/athenax/.env
Environment=HOME=/opt/athenax
Environment=DASHBOARD_PORT=8080
Environment=DASHBOARD_DEV=false
ExecStart=/opt/athenax/.venv/bin/athenax dashboard
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
MemoryMax=200M
Nice=15

[Install]
WantedBy=multi-user.target
